{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
{%- if output_style != 'default' %}
  "outputStyle": "{{ output_style }}",
{%- endif %}
  "model": "{{ model_mid }}",
  "attribution": {
    "commit": "",
    "pullRequest": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(tree:*)",
{% if language == 'python' and package_manager == 'uv' -%}
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(pyright:*)",
{%- elif language == 'python' -%}
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(pip:*)",
{%- elif language == 'typescript' -%}
      "Bash({{ package_manager }}:*)",
      "Bash(npx:*)",
{%- elif language == 'go' -%}
      "Bash(go:*)",
{%- elif language == 'rust' -%}
      "Bash(cargo:*)",
{%- endif %}
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(git reset --hard origin/master:*)",
      "WebFetch(domain:internal.example.com)"
    ]
  },
  "hooks": {
{%- set pre_tool_use_hooks = [] %}
{%- if 'block-secret-edits' in hooks %}
{%- set _ = pre_tool_use_hooks.append({"matcher": "Edit|Write|MultiEdit", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-edits.sh"}) %}
{%- endif %}
{%- if 'warn-on-lockfile-edit' in hooks %}
{%- set _ = pre_tool_use_hooks.append({"matcher": "Edit|Write|MultiEdit", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/warn-on-lockfile-edit.sh"}) %}
{%- endif %}
{%- if 'block-dangerous-bash' in hooks %}
{%- set _ = pre_tool_use_hooks.append({"matcher": "Bash", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-bash.sh"}) %}
{%- endif %}
{%- if 'tests-before-pr' in hooks %}
{%- set _ = pre_tool_use_hooks.append({"matcher": "Bash|mcp__github__create_pull_request", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tests-before-pr.sh"}) %}
{%- endif %}
{%- set top_level_blocks = [] %}
{%- if pre_tool_use_hooks %}{% set _ = top_level_blocks.append('PreToolUse') %}{% endif %}
{%- if 'route-perms-to-opus' in hooks %}{% set _ = top_level_blocks.append('PermissionRequest') %}{% endif %}
{%- if 'notify-on-stop' in hooks %}{% set _ = top_level_blocks.append('Stop') %}{% endif %}
{%- for block_name in top_level_blocks %}
{%- if block_name == 'PreToolUse' %}
    "PreToolUse": [
{%- for entry in pre_tool_use_hooks %}
      {
        "matcher": "{{ entry.matcher }}",
        "hooks": [
          {
            "type": "command",
            "command": "{{ entry.command }}"
          }
        ]
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    ]{% if not loop.last %},{% endif %}
{%- elif block_name == 'PermissionRequest' %}
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/route-perms-to-opus.sh"
          }
        ]
      }
    ]{% if not loop.last %},{% endif %}
{%- elif block_name == 'Stop' %}
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify-on-stop.sh"
          }
        ]
      }
    ]{% if not loop.last %},{% endif %}
{%- endif %}
{%- endfor %}
  }
}
