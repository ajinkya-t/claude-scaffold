name: Claude Tech-Debt Sweep

on:
  pull_request:
    types: [opened, synchronize]

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: claude-techdebt-${{ '{{' }} github.event.pull_request.number {{ '}}' }}
  cancel-in-progress: true

jobs:
  techdebt:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Claude tech-debt sweep
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ '{{' }} secrets.ANTHROPIC_API_KEY {{ '}}' }}
          claude_args: "--model {{ model_low }}"
          prompt: |
            Scan only the changed files in this PR for:
            1. Duplicated functions or near-duplicated logic (compare against existing code, not just within the diff)
            2. Unused imports, unused variables, dead branches
            3. Hardcoded values that should be named constants
            4. Commented-out code blocks (git already remembers; delete them)

            One finding per comment, anchored at the line.
            Format: `<issue type>: <what to do>`.

            Do NOT report:
            - Style issues (linters handle those)
            - Missing tests (covered by the review workflow)
            - Anything that requires changes outside the changed files

            If there are no findings, post a single comment saying "No tech-debt findings."
